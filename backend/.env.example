# Healthcare Appointment & Follow-up Manager — Environment Variables
# Copy this file to .env and fill in the values

# ─── Server ───────────────────────────────────────────────
PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# ─── Database ─────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/healthcare_db

# ─── Redis ────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── JWT ──────────────────────────────────────────────────
JWT_SECRET=your-jwt-secret-change-in-production
JWT_REFRESH_SECRET=your-jwt-refresh-secret-change-in-production
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ─── Anthropic LLM ───────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-your-api-key-here
LLM_TIMEOUT_MS=30000

# ─── Email (SMTP) ────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=Healthcare App <noreply@healthcare.app>

# ─── Google Calendar OAuth ────────────────────────────────
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/calendar/callback

# ─── Booking ─────────────────────────────────────────────
SLOT_HOLD_MINUTES=5

# ─── Notification Retry ──────────────────────────────────
NOTIFICATION_MAX_RETRIES=5
